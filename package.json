{
  "name": "david-skills",
  "version": "1.6.0",
  "private": true,
  "description": "David's personal agent skills for real engineering, forked from mattpocock/skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dlybeck/David-Skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "check:repo": "python3 scripts/validate_repo.py",
    "test:hooks": "python3 hooks/test_hooks.py",
    "test:release": "python3 scripts/test_direct_release.py",
    "test:pilots": "python3 scripts/test_pilot_scenarios.py",
    "test:evaluator": "python3 scripts/test_evaluate_toolkit.py",
    "test:version-sync": "python3 scripts/test_sync_plugin_version.py",
    "test": "npm run check-plugin-version && npm run check:repo && npm run test:hooks && npm run test:pilots && npm run test:version-sync && npm run test:evaluator"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
